---
// The homepage: a pinned hero and five-step story on one phone, then the
// backends, voice and reach, privacy, the smaller features, setup, FAQ and the
// close. The markup is static; `src/scripts/home/` adds the motion.
import Backends from '../components/home/Backends.astro';
import Box from '../components/home/Box.astro';
import Closing from '../components/home/Closing.astro';
import { faq } from '../components/home/content';
import Faq from '../components/home/Faq.astro';
import Reach from '../components/home/Reach.astro';
import Setup from '../components/home/Setup.astro';
import Stage from '../components/home/Stage.astro';
import { links } from '../data/links';
import Layout from '../layouts/Layout.astro';
import '../styles/home/base.css';
import '../styles/home/stage.css';
import '../styles/home/sections.css';

const description =
  'Heeler is a mobile agent console for herdr, herdr-core, and tmux on iPhone and iPad. Control Claude Code and Codex over SSH, with native Chat, encrypted alerts, and Usage widgets.';

const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#website`,
      name: 'Heeler',
      url: Astro.site?.href,
      inLanguage: 'en',
    },
    {
      '@type': 'MobileApplication',
      name: 'Heeler',
      url: Astro.site?.href,
      description,
      applicationCategory: 'DeveloperApplication',
      operatingSystem: 'iOS, iPadOS',
      downloadUrl: links.appStore,
      image: new URL('/logo.png', Astro.site).href,
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map(({ q, a }) => ({
        '@type': 'Question',
        name: q,
        acceptedAnswer: { '@type': 'Answer', text: a },
      })),
    },
  ],
};
---

<Layout title="Heeler — Claude Code & Codex on iPhone and iPad" description={description}>
  <script is:inline slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />
  <Stage />
  <Backends />
  <Reach />
  <Box />
  <Setup />
  <Faq />
  <Closing />
</Layout>

<script>
  import '../scripts/home/index';
</script>
