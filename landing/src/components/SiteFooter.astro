---
import { links } from '../data/links';
import Logo from './Logo.astro';

interface Props {
  home: boolean;
}

const { home } = Astro.props;
---

<div class="lp lp-chrome">
  <footer class="ft">
    <div class="wrap">
      <a class="brand" href={home ? '#top' : '/'}><Logo />Heeler</a>
      <nav aria-label="Footer">
        <a href={links.docs} target="_blank" rel="noopener">Docs</a>
        <a href={links.github} target="_blank" rel="noopener">GitHub</a>
        <a href={links.privacy} target="_blank" rel="noopener">Privacy</a>
      </nav>
      <p>Not affiliated with Anthropic, OpenAI, or the herdr project.</p>
    </div>
  </footer>
</div>
