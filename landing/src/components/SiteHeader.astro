---
// The sticky header. Its behaviour (scrolled state, folded menu, in-page
// scrolling) is in `src/scripts/header.ts`.
import { links } from '../data/links';
import Logo from './Logo.astro';

interface Props {
  /** On the homepage the section links are in-page; elsewhere they lead back to it. */
  home: boolean;
}

const { home } = Astro.props;
const base = home ? '' : '/';
const nav = [
  { label: 'Features', href: `${base}#features` },
  { label: 'Backends', href: `${base}#backends` },
  { label: 'Security', href: `${base}#private` },
  { label: 'FAQ', href: `${base}#faq` },
  { label: 'Docs', href: links.docs, external: true },
  { label: 'GitHub', href: links.github, external: true },
];
---

<div class="lp lp-chrome">
  <a class="skip" href="#main">Skip to content</a>
  <i class="sen"></i>
  <header class="hd">
    <div class="wrap hd-in">
      <a class="brand" href={home ? '#top' : '/'} aria-label={home ? 'Heeler, back to top' : 'Heeler, home'}>
        <Logo />Heeler
      </a>
      <nav class="nav" aria-label="Main">
        {
          nav.map((link, i) => (
            <a href={link.href} style={`--i:${i}`} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener' : undefined}>
              {link.label}
            </a>
          ))
        }
      </nav>
      <a class="btn" href={links.appStore} target="_blank" rel="noopener">Get the app</a>
      <button class="mn" type="button" aria-label="Menu" aria-expanded="false"><i></i><i></i></button>
    </div>
  </header>
</div>
