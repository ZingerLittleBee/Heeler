---
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

const links = [
  { href: '#features', label: 'Features' },
  { href: '#connect', label: 'How it connects' },
  { href: '#security', label: 'Security' },
  { href: '#faq', label: 'FAQ' },
];
---

<header class="header">
  <div class="bar">
    <a class="brand" href="#top">
      <Image class="mark" src={logo} alt="" width={28} height={28} densities={[2, 3]} loading="eager" />
      <span class="wordmark">Heeler</span>
    </a>
    <nav class="nav" aria-label="Sections">
      {links.map((link) => <a class="nav-link" href={link.href}>{link.label}</a>)}
    </nav>
    <div class="spacer"></div>
    <a
      class="sb-btn sb-btn--secondary sb-btn--sm github"
      href="https://github.com/ZingerLittleBee/Heeler"
      aria-label="Heeler on GitHub"
      title="Heeler on GitHub"
    >
      <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" fill="currentColor">
        <path
          d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0 0 16 8c0-4.42-3.58-8-8-8z"
        />
      </svg>
    </a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background: var(--surface-glass);
    backdrop-filter: var(--blur-glass);
    border-bottom: 1px solid var(--border-hairline);
  }

  .bar {
    max-width: var(--w-container);
    margin: 0 auto;
    height: var(--h-header);
    padding: 0 var(--gutter-x);
    display: flex;
    align-items: center;
    gap: var(--sp-8);
  }

  .brand {
    display: flex;
    align-items: center;
    gap: var(--sp-2-5);
    color: var(--text-primary);
  }

  .mark {
    border-radius: 6px;
  }

  .wordmark {
    font: var(--fw-medium) 17px/1 var(--font-sans);
    letter-spacing: var(--tr-heading);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: var(--sp-6);
    margin-left: var(--sp-2);
  }

  .nav-link {
    font: var(--type-label);
    color: var(--text-secondary);
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .spacer {
    flex: 1;
  }

  /* Icon-only GitHub link: a square control at the small button height. */
  .github {
    width: var(--h-control-sm);
    padding: 0;
    flex-shrink: 0;
  }

  /* Below the point where the four section links stop fitting, the header
   * keeps the brand and the one action that matters. */
  @media (max-width: 900px) {
    .nav {
      display: none;
    }

    .bar {
      gap: var(--sp-4);
    }
  }
</style>
