---
import Button from './Button.astro';
---

<section class="section">
  <div class="container layout">
    <div>
      <h2 class="section-title heading">On the App Store. Open on GitHub.</h2>
      <p class="section-lede lede">Install it from the App Store, or clone the repo and build it yourself. Reports on how transport and terminal behaviour hold up on your machines are the most useful thing you can send.</p>
    </div>
    <div class="actions">
      <Button href="https://apps.apple.com/us/app/heeler-for-herdr/id6797263135">Get it on the App Store</Button>
      <Button href="https://github.com/ZingerLittleBee/Heeler" variant="secondary">Star on GitHub</Button>
      <Button href="https://github.com/ZingerLittleBee/Heeler/issues" variant="secondary">Open an issue</Button>
    </div>
  </div>
</section>

<style>
  .layout {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-12);
  }

  .heading {
    margin-top: 0;
  }

  .lede {
    margin-top: var(--sp-4);
    max-width: 520px;
  }

  .actions {
    display: flex;
    gap: var(--sp-3);
    flex: none;
  }

  @media (max-width: 900px) {
    .layout {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sp-8);
    }
  }

  @media (max-width: 560px) {
    .actions {
      flex-direction: column;
      align-self: stretch;
    }
  }
</style>
