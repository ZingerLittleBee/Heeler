---
import { path } from './content';
---

<ol class="hops" aria-label="Connection path">
  {
    path.map((hop, index) => (
      <li class="hop">
        <span class="index">{String(index + 1).padStart(2, '0')}</span>
        <span class="node">{hop.node}</span>
        <span class="note">{hop.note}</span>
      </li>
    ))
  }
</ol>

<style>
  .hops {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    border: 1px solid var(--border-hairline);
    border-radius: var(--r-card);
    overflow: hidden;
  }

  .hop {
    position: relative;
    display: grid;
    gap: 6px;
  }

  .index {
    font: var(--type-eyebrow);
    color: var(--text-muted);
  }

  .node {
    font: var(--fw-medium) var(--fs-body-sm) / 1.3 var(--font-mono);
    color: var(--text-primary);
  }

  .note {
    font: var(--type-mono-sm);
    color: var(--text-muted);
  }

  .hops .hop {
    padding: 18px 20px;
    background: var(--surface-card);
  }

  .hops .hop + .hop {
    border-left: 1px solid var(--border-hairline);
  }

  /* A chevron on each seam marks the direction of travel. */
  .hops .hop + .hop::before {
    content: '';
    position: absolute;
    left: -4px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-top: 1px solid var(--border-default);
    border-right: 1px solid var(--border-default);
    background: var(--surface-card);
    transform: translateY(-50%) rotate(45deg);
  }

  @media (max-width: 860px) {
    .hops {
      grid-template-columns: 1fr;
    }

    .hops .hop {
      grid-template-columns: 32px minmax(0, 1fr) auto;
      align-items: baseline;
      gap: var(--sp-3);
      padding: 14px 16px;
    }

    .hops .hop + .hop {
      border-left: 0;
      border-top: 1px solid var(--border-hairline);
    }

    .hops .hop + .hop::before {
      display: none;
    }

    .hops .note {
      text-align: right;
    }
  }

  @media (max-width: 420px) {
    .hops .hop {
      grid-template-columns: 32px minmax(0, 1fr);
    }

    .hops .note {
      grid-column: 2;
      text-align: left;
    }
  }
</style>
