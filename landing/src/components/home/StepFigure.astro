---
// A pinned figure beside the steps of its story. Scrolling moves through the
// steps: the page script marks the step on its reading line and plays the
// figure up to that step's beat through the figure page's
// window.heelerFigure hook. Each step's title links to it, like the chapter
// index. Without the script, the figure runs its own tour.
import FigureFrame from './FigureFrame.astro';
import type { FigureEmbed } from './figures';

export interface FigureStep {
  beat: string;
  title: string;
  body: string;
}

interface Props {
  figure: FigureEmbed;
  steps: FigureStep[];
}

const { figure, steps } = Astro.props;
---

<div class="steps" data-steps>
  <div class="figure" data-pin>
    <FigureFrame figure={figure} />
  </div>
  <ol class="list">
    {
      steps.map((step, index) => (
        <li class="step" id={`${figure.slug}-${step.beat}`} data-beat={step.beat}>
          <a class="title" href={`#${figure.slug}-${step.beat}`}>
            <span class="n">{String(index + 1).padStart(2, '0')}</span>
            {step.title}
          </a>
          <p class="home-body" set:html={step.body} />
        </li>
      ))
    }
  </ol>
</div>

<style>
  .steps {
    --line: 45vh;
    display: grid;
    grid-template-columns: minmax(0, 260px) minmax(0, 1fr);
    grid-template-areas: 'list figure';
    gap: 40px;
    align-items: start;
  }

  .figure {
    grid-area: figure;
    position: sticky;
    top: calc(var(--h-header) + 40px);
  }

  .list {
    grid-area: list;
    display: flex;
    flex-direction: column;
    margin: 0;
    /* The first step starts level with the figure's middle, the last one
       can still reach the reading line. */
    padding: 18vh 0 24vh;
    list-style: none;
  }

  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    /* Shorter than the reading line's height, so a step's title is still in
       view when the next one takes over. */
    min-height: 42vh;
    padding: var(--sp-1) 0 var(--sp-1) var(--sp-4);
    border-left: 1px solid var(--border-hairline);
    scroll-margin-top: var(--line);
    transition: opacity var(--dur-slower) var(--ease-out);
  }

  .step:last-child {
    min-height: 0;
  }

  .step::before {
    content: '';
    position: absolute;
    top: 0;
    left: -1px;
    width: 1px;
    height: 100%;
    background: var(--text-primary);
    opacity: 0;
    transition: opacity var(--dur-slower) var(--ease-out);
  }

  .title {
    display: flex;
    gap: var(--sp-2);
    font: var(--fw-medium) 15px / 1.4 var(--font-sans);
    color: var(--text-primary);
    text-decoration: none;
  }

  .title:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .title:focus-visible {
    outline: 1px solid var(--text-primary);
    outline-offset: 4px;
  }

  .n {
    font: var(--fw-regular) 12px / 21px var(--font-mono);
    color: var(--text-muted);
  }

  .step .home-body {
    font-size: 14px;
  }

  /* Once the script follows the scroll, the steps off the line recede. */
  :global(.steps-live) .step:not([data-current]) {
    opacity: 0.45;
  }

  :global(.steps-live) .step[data-current]::before {
    opacity: 1;
  }

  @media (max-width: 1100px) {
    .steps {
      grid-template-columns: minmax(0, 220px) minmax(0, 1fr);
      gap: 32px;
    }
  }

  /* Stacked, the figure pins under the chapter strip and the steps pass
     beneath it; the canvas behind the figure hides them as they go under. */
  @media (max-width: 960px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'figure' 'list';
      gap: 0;
    }

    .figure {
      z-index: 1;
      top: calc(var(--h-header) + 53px);
      margin: 0 calc(-1 * var(--gutter-x));
      padding: 12px var(--gutter-x) 16px;
      background: var(--surface-canvas);
    }

    .figure > :global(*) {
      max-width: 560px;
      margin-inline: auto;
    }

    /* No run after the last step: the figure lets go as that step reaches it. */
    .list {
      padding: 8px 0 0;
    }

    .step {
      min-height: var(--run, 24vh);
    }
  }
</style>
