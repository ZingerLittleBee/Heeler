relay/.dev.vars
relay/.wrangler/
relay/node_modules/
*.p8

# Python (test fixtures under scripts/fixtures)
__pycache__/
*.pyc

# macOS
.DS_Store

# Local-only notes and experiments
.local/

# testloop scratch artifacts
.testloop/

# Agent workspace (research reports, scratch)
.claude/

# Android
android/.gradle/
android/local.properties
android/**/build/
android/app/src/main/jniLibs/
android/native/.zig-cache/
android/native/zig-out/
android/app/google-services.json
android/keystore.properties

# Local build deliverables (sideload APKs etc.); never repo content.
output/
