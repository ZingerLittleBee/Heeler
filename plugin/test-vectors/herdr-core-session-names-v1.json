  "cases": [
    { "name": "a plain name is kept", "raw": "work", "normalized": "work" },
    { "name": "letters, digits and - _ . are kept", "raw": "phone-work_1.2", "normalized": "phone-work_1.2" },
    { "name": "spaces around it are trimmed", "raw": "  work  ", "normalized": "work" },
