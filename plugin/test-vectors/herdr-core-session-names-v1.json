    { "name": "an empty name is default", "raw": "", "normalized": "default" },
    { "name": "a blank name is default", "raw": "   ", "normalized": "default" },
    { "name": "a lone newline is default", "raw": "\n", "normalized": "default" },
    { "name": "an inner space is kept", "raw": "work team", "normalized": "work team" },
    { "name": "non-ASCII is kept", "raw": "東京", "normalized": "東京" },
