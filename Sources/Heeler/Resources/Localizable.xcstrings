    "Branch name components cannot start with \".\" or end with \".lock\"." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブランチ名の各構成要素は「.」で始めたり「.lock」で終わったりできません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分支名称的各部分不能以“.”开头或以“.lock”结尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分支名稱的各個部分不可以「.」開頭，也不可以「.lock」結尾。"
          }
        }
      }
    },
    "Branch names cannot contain \"..\" or \"@{\"." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブランチ名に「..」や「@{」は使えません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分支名称不能包含“..”或“@{”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分支名稱不可包含「..」或「@{」。"
          }
        }
      }
    },
    "Branch names cannot contain spaces, control characters, or any of ~ ^ : ? * [ \\." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブランチ名には空白・制御文字・次の文字は使えません: ~ ^ : ? * [ \\"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分支名称不能包含空格、控制字符，或 ~ ^ : ? * [ \\ 中的任一字符。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分支名稱不可包含空格、控制字元，或 ~ ^ : ? * [ \\ 其中任一字元。"
          }
        }
      }
    },
    "Branch names cannot end with \".\"." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブランチ名は「.」で終われません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分支名称不能以“.”结尾。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分支名稱不可以「.」結尾。"
          }
        }
      }
    },
    "Branch names cannot start or end with \"/\" or contain \"//\"." : {
      "localizations" : {
        "ja" : {
