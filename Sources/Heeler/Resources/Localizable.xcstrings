    },
    "This closes the pane on the Host and removes the agent everywhere. This can't be undone." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト上のこのペインを閉じ、エージェントをあらゆる場所から削除します。これは取り消せません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将关闭主机上的窗格，并从所有位置移除该 Agent。此操作无法撤销。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會關閉主機上的窗格，並在所有地方移除這個 Agent。此操作無法復原。"
          }
        }
      }
    },
    "This closes the pane on the Host, ending anything running in it. Going Back instead leaves it for desktop handoff." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト上のこのペインを閉じ、中で動作しているものを終了させます。「戻る」を選ぶと、デスクトップ側へ引き継ぐため残ります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会关闭主机上的该窗格，并终止其中运行的所有程序。若选择“返回”，则会保留该窗格以便在桌面端继续使用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會關閉主機上的窗格，並結束其中執行的所有內容。改按「返回」則會保留它，供桌面端接手。"
          }
        }
      }
    },
    "This connection can't read Changes." : {
