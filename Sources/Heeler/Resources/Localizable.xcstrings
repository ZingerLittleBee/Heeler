    "Chat shows this conversation once its Host connects. This device hasn't saved any of it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストが接続すると、チャットはこの会話を表示します。このデバイスには何も保存されていません。"
          }
        }
      }
    },
    "Check Again" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "再確認"
          }
        }
      }
    },
    "Check its settings in Settings › Overlay Networks." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
