          "stringUnit": {
            "state": "translated",
            "value": "このリストは最新ではありません。"
          }
        }
      }
    },
    "This machine only gave a link-local IPv6 address. Enter its IPv4 address by hand.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
