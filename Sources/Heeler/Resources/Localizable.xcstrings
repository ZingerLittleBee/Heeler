    },
    "This program hasn't reported a status." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプログラムはステータスを報告していません。"
          }
        }
      }
    },
    "This program hasn't reported a status. It reports one from version %@, so an older version stays Unknown." : {
      "comment" : "%@ is a version",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプログラムはステータスを報告していません。ステータスはバージョン %@ から報告されるため、それより古いバージョンでは「不明」のままです。"
          }
        }
      }
    },
    "This prompt changed. Check it before answering." : {
      "comment" : "Blocked card notice when the dialog changed under the card",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このプロンプトは変更されました。回答する前に確認してください。"
          }
        }
      }
    },
    "This route's overlay network was removed. Choose another network or Direct." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この経路のオーバーレイネットワークは削除されました。別のネットワークか「直接」を選んでください。"
          }
        }
      }
    },
    "This row starts from herdr's sidebar fields; Sync from plugin refills it. Heeler fields are welcome here too." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この行は herdr のサイドバーフィールドから始まり、「プラグインから同期」で再設定されます。Heeler のフィールドもここで使えます。"
          }
        }
      }
    },
    "This service does not document a language setting." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このサービスには言語設定に関する記載がありません。"
          }
        }
      }
    },
    "This session does not offer that mode. The original permission mode is restored." : {
      "comment" : "Error when the chosen permission mode is not offered; the old mode was restored.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
