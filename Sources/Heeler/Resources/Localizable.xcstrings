          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode 的 /compact 不接受額外指示。請單獨傳送 /compact。"
          }
        }
      }
    },
    "OpenCode's conversation is too large to read in one query." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
