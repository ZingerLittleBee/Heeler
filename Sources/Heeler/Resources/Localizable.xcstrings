          }
        }
      }
    },
    "herdr hasn't reported a Grok Build session ID for this Agent. Grok Build reports one when a session starts, including after /new or /clear. Chat keeps checking; you can continue in the Agent terminal." : {
      "localizations" : {
        "ja" : {
