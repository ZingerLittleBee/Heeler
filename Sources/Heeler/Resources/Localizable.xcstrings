      }
    },
    "Closing the pane failed: %@": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペインを閉じられませんでした: %@"
          }
        }
      }
    },
    "Code stays monospaced, and the text size follows the system's from there. A finished turn's steps fold behind one line above its answer; a turn stays open while it runs or while its background work does.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードは等幅のままとなり、文字サイズはシステムの設定に追従します。完了したターンの手順はその回答の上 1 行に折りたたまれ、ターンは実行中もバックグラウンド作業の最中も開いたままです。"
          }
        }
      }
    },
    "Codex": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex"
          }
        }
