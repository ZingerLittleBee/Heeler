    "%@ Check the network's settings." : {
      "comment" : "Overlay failure explanation. %@ is the overlay's own detail sentence, which may be English.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ネットワークの設定を確認してください。"
          }
        }
      }
    },
    "%@ Check the title in Terminal before trying again." : {
      "comment" : "Rename outcome unknown; %@ is the full reason sentence",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ターミナルでタイトルを確認してから再試行してください。"
          }
        }
      }
    },
    "%@ Edit the network to fix it." : {
      "comment" : "Overlay failure explanation. %@ is the overlay's own detail sentence, which may be English.",
