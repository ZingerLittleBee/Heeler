    "This permanently deletes the Host configuration, its trusted host key, and any saved password from the Keychain." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはホスト設定とその信頼済みホスト鍵、そしてキーチェーン内の保存済みパスワードを恒久的に削除します。"
          }
        }
      }
    },
    "This permanently deletes the Host configuration, its trusted host key, any saved password, and the Notification Key from the Keychain." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはホスト設定とその信頼済みホスト鍵、保存済みパスワード、そしてキーチェーン内の通知鍵を恒久的に削除します。"
