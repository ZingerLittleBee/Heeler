      }
    },
    "Opens a new shell tab in %@. Choose New Workspace in the menu to start somewhere else.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に新しいシェルのタブを開きます。他の場所で始めるにはメニューで「新規ワークスペース」を選んでください。"
          }
        }
      }
    },
    "Opens a new shell tab in this Workspace": {
      "extractionState": "manual",
