    },
    "%@ Finish here or in the terminal." : {
      "comment" : "Blocked card notice; %@ is a whole sentence saying why the card stopped",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ここかターミナルで完了してください。"
