    },
    "Add \"%@\" to %@ in %@ on OpenCode 1.x, or to %@ in %@ on 2.x, with a copy of Heeler's plugin in a folder of that name beside the file." : {
      "comment" : "Entry, 1.x list key, 1.x file, 2.x list key, 2.x file",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode 1.x では %3$@ 内の %2$@ に、2.x では %5$@ 内の %4$@ に \"%1$@\" を追加し、そのファイルの隣にその名前のフォルダを作って Heeler のプラグインのコピーを置きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 OpenCode 1.x 中将 \"%1$@\" 添加到 %3$@ 中的 %2$@，或在 2.x 中添加到 %5$@ 中的 %4$@，并在该文件旁创建同名文件夹，放入 Heeler 插件的副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 OpenCode 1.x 上，將「%@」加入 %@（位於 %@）；在 2.x 上則加入 %@（位於 %@）。並在檔案旁以相同名稱的資料夾放入一份 Heeler 外掛的副本。"
          }
        }
      }
    },
    "Add \"%@\" to %@ in %@, with a copy of Heeler's plugin in a folder of that name beside the file." : {
      "comment" : "Entry, list key, file name",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ 内の %2$@ に \"%1$@\" を追加し、そのファイルの隣にその名前のフォルダを作って Heeler のプラグインのコピーを置きます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 \"%1$@\" 添加到 %3$@ 中的 %2$@，并在该文件旁创建同名文件夹，放入 Heeler 插件的副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將「%@」加入 %@（位於 %@），並在檔案旁以相同名稱的資料夾放入一份 Heeler 外掛的副本。"
          }
        }
      }
    },
    "Add \"%@\" to %@ inside %@ in %@, not at the top of the file, where a list would replace the one inside %@, with a copy of Heeler's plugin in a folder of that name beside the file." : {
      "comment" : "Entry, list key, section, file name, section",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%4$@ 内の %3$@ 内の %2$@ に \"%1$@\" を追加し、そのファイルの隣にその名前のフォルダを作って Heeler のプラグインのコピーを置きます。ファイルの先頭に置くと、そのリストが %5$@ 内のリストを置き換えてしまいます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将 \"%1$@\" 添加到 %4$@ 中 %3$@ 内的 %2$@（不要放在文件顶层，否则顶层列表会替换 %5$@ 内的列表），并在该文件旁创建同名文件夹，放入 Heeler 插件的副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將「%@」加入 %@，位置在 %@ 之內（檔案 %@），而不是檔案最上層，因為最上層的清單會取代 %@ 內的那一份。並在檔案旁以相同名稱的資料夾放入一份 Heeler 外掛的副本。"
          }
        }
      }
    },
