    },
    "Add \"%@\" to %@ in %@ on OpenCode 1.x, or to %@ in %@ on 2.x, with a copy of Heeler's plugin in a folder of that name beside the file." : {
      "comment" : "Entry, 1.x list key, 1.x file, 2.x list key, 2.x file",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode 1.x では %3$@ 内の %2$@ に、2.x では %5$@ 内の %4$@ に \"%1$@\" を追加し、そのファイルの隣にその名前のフォルダを作って Heeler のプラグインのコピーを置きます。"
          }
        }
      }
    },
    "Add \"%@\" to %@ in %@, with a copy of Heeler's plugin in a folder of that name beside the file." : {
      "comment" : "Entry, list key, file name",
      "localizations" : {
