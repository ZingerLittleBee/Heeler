    "Notifications from your other herdr sessions on this Host may reach this device until the plugin is %@ or newer; this Host has %@." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラグインが %@ 以降になるまで、このホスト上の他の herdr セッションからの通知がこのデバイスに届く可能性があります。このホストには %@ が導入されています。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在插件升级到 %@ 或更高版本之前，此主机上其他 herdr 会话的通知可能会发送到此设备；此主机当前版本为 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在外掛更新到 %@ 以上版本之前，此主機上你其他 herdr 工作階段的通知可能也會傳到這部裝置；此主機目前是 %@。"
          }
        }
      }
