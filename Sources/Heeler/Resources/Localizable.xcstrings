        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "片語最多只能有 %lld 個字元。"
          }
        }
      }
    },
    "A Snippet needs some text." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スニペットにはテキストが必要です。"
