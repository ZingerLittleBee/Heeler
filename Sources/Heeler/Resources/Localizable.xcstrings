          }
        }
      }
    },
    "Host key changed: trusted %@, the Host presented %@. This can be a reinstalled server or an attack — verify with the Host's owner before trusting it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト鍵が変更されました: 信頼済み %@、ホストが提示したのは %@。再インストールされたサーバーか攻撃の可能性があります。信頼する前にホストの所有者に確認してください。"
          }
        }
      }
    },
    "Host key pinned from the Pairing Code — no fingerprint prompt." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト鍵はペアリングコードから固定されているため、フィンガープリント確認はありません。"
