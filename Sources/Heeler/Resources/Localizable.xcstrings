    " launchd answers this for more than one cause, such as another copy already loaded.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " launchd はこれへの答えを複数理由で返すことがあります。すでに別のコピーが読み込まれている場合などです。"
          }
        }
      }
    },
