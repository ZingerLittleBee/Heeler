      }
    },
    "Use the account your Mac is signed in with." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac でサインイン中のアカウントを使ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请使用你 Mac 上登录的同一账户。"
