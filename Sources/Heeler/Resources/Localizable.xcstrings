            "value" : "ZeroTier 預設值"
          }
        }
      }
    },
    "[OpenCode shortened this output. The full output stays on the Host.]" : {
      "comment" : "Line appended to a tool output OpenCode shortened itself",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[OpenCode がこの出力を短縮しました。完全な出力はホストに残っています。]"
