    },
    "This Host has Host Helper %@, newer than this app's. Update the app to change it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストにはこのアプリより新しい Host Helper %@ があります。変更するにはアプリを更新してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此主机上的 Host Helper 为 %@，比当前 App 内置的版本更新。请更新 App 以对其进行更改。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此主機的 Host Helper 為 %@，比此 App 內建的版本新。請更新 App 後再變更。"
          }
        }
      }
    },
    "This Host has git %@. Changes requires git 2.17 or later." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
