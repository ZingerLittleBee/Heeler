    " An administrator can run: sudo loginctl enable-linger %@": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者が実行できます: sudo loginctl enable-linger %@"
          }
        }
      }
    },
    " Check the network's settings.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " ネットワークの設定を確認してください。"
          }
        }
      }
    },
    " Check the title in Terminal before trying again.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " ターミナルでタイトルを確認してから再試行してください。"
          }
        }
      }
    },
    " Edit the network to fix it.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " ネットワークを編集して直してください。"
          }
        }
      }
    },
    " If an admin must approve this device, authorize it in the network's admin console.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者がこのデバイスの承認を必要とする場合は、ネットワークの管理コンソールで承認してください。"
          }
        }
      }
    },
    " Showing saved messages.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（保存済みのメッセージを表示しています）"
          }
        }
      }
    },
    " Without it, Chat follows the conversation after its first message.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " これがなければ、チャットは最初のメッセージのあとに会話を追跡します。"
          }
        }
      }
    },
    " ZeroTier does not report member addresses; copy %@'s managed IP from ZeroTier Central or your controller.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ZeroTier はメンバーアドレスを報告しないため、%@ の管理 IP を ZeroTier Central かコントローラーからコピーしてください。"
          }
        }
      }
    },
    " and update the plugin:": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": " とプラグインを更新してください:"
          }
        }
      }
    },
    " copy": {
      "extractionState": "manual",
      "localizations": {
