    },
    "The same name and secret as on your Mac. Peers are how the two find each other, such as tcp://public.easytier.top:11010, one per line." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お使いの Mac と同じ名前とシークレットです。ピアは両者が出会うための手段で、1 行に 1 つずつ（例: tcp://public.easytier.top:11010）入力します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用与你 Mac 上相同的名称和密钥。节点地址用于让双方互相发现，例如 tcp://public.easytier.top:11010，每行一个。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與你 Mac 上相同的名稱和密鑰。節點用來讓兩者互相找到對方，例如 tcp://public.easytier.top:11010，每行一個。"
          }
        }
      }
