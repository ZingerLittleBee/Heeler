    },
    "Either answer forks this conversation and moves Grok Build to the fork. Chat stays here and holds messages until you switch back with /resume in the terminal." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらの回答もこの会話をフォークし、Grok Build をそのフォークへ移動します。チャットはここに残り、ターミナルの /resume で戻るまでメッセージを保持します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无论选择哪个回答，都会为此对话创建分支并将 Grok Build 切换到该分支。对话会留在此处并暂存消息，直到你在终端中用 /resume 切回。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任一回答都會分岔此對話，並將 Grok Build 移到分岔上。對話檢視會留在這裡並暫存訊息，直到你在終端機用 /resume 切換回來。"
          }
        }
      }
    },
    "Empty keeps herdr's numbered tab name." : {
