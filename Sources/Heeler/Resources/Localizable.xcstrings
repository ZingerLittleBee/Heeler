    "Agent names are 1–32 characters: lowercase letters, digits, - or _, starting with a lowercase letter." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェント名は 1〜32 文字で、英小文字・数字・- ・_ を使えます。最初は英小文字です。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 名称长度为 1–32 个字符：可使用小写字母、数字、- 或 _，且必须以小写字母开头。"
