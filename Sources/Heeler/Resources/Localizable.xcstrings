        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它仍可能完成。再次嘗試前請先檢查終端機。"
          }
        }
      }
    },
    "Its first start can take up to 35 seconds." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "初回の起動には最大 35 秒かかることがあります。"
