    " launchd answers this for more than one cause, such as another copy already loaded." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " launchd は、別のコピーがすでに読み込まれている場合など、複数の原因でこの応答を返します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " launchd 返回此响应可能有多种原因，例如已加载了另一个副本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : " launchd 在多種情況下都會這樣回應，例如已載入另一份副本。"
          }
        }
      }
    },
    " · %@" : {
      "shouldTranslate" : false
    },
    "\"%@\" leaves no folder name for the checkout. Use a branch with ASCII letters or digits in it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」からはチェックアウト用のフォルダ名が作れません。ASCII の英数字を含むブランチを使ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法从“%@”生成检出目录的文件夹名称。请使用包含 ASCII 字母或数字的分支。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」無法產生簽出所需的資料夾名稱。請使用含有 ASCII 英文字母或數字的分支。"
          }
        }
      }
    },
