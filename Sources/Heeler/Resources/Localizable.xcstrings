    "Jump Host: %@\n\nCompare the new key with what the command prints on the Jump Host first. A changed key can indicate a reinstalled Jump Host or an attack." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジャンプホスト: %@\n\nまず新しい鍵が、ジャンプホストでコマンドが表示するものと一致するか比較してください。鍵の変更は、ジャンプホストの再インストールか攻撃を示している可能性があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳板机：%@\n\n请先将新密钥与该命令在跳板机上输出的结果进行比对。密钥发生变化可能意味着跳板机已重装或遭受了攻击。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳板主機：%@\n\n請先把新金鑰與在跳板主機上執行指令所印出的內容比對。金鑰變更可能代表跳板主機已重新安裝，也可能是遭到攻擊。"
          }
        }
      }
    },
