        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配對意外失敗。請用同一組配對碼再試一次。（%@）"
          }
        }
      }
    },
    "Pairing runs this launcher as %@ on the Host. Pair only with a code your own Host showed you." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリングでは、このランチャーをホスト上で %@ として実行します。自分のホストが表示したコードでのみペアリングしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配对会在主机上以 %@ 身份运行此启动器。请仅使用你自己的主机显示的配对码进行配对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配對會在主機上以 %@ 的身分執行此啟動器。請只使用你自己的主機顯示的配對碼來配對。"
          }
        }
      }
    },
    "Pairing succeeded, but the Host could not be saved because the Host catalog on this device is unreadable. Resolve that first, then pair again with a fresh code." : {
      "comment" : "Pairing failure",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ペアリングは成功しましたが、このデバイスのホストカタログが読み取れないためホストを保存できませんでした。まずそれを解決してから、新しいコードで再度ペアリングしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配对已成功，但此设备上的主机列表无法读取，导致无法保存该主机。请先解决此问题，然后使用新的配对码重新配对。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "配對成功，但這部裝置上的主機目錄無法讀取，所以無法儲存此主機。請先解決這個問題，再用新的配對碼重新配對。"
          }
        }
      }
