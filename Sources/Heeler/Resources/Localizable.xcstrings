        }
      }
    },
    "This link couldn't be opened.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクを開けませんでした。"
          }
        }
      }
    },
    "This list is out of date.": {
      "extractionState": "manual",
