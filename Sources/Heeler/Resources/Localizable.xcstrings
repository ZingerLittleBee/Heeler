    "Open it again from the list.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一覧からもう一度開いてください。"
          }
        }
      }
    },
    "Open the questions first.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず質問を開いてください。"
          }
