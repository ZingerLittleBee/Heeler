            "value": "そのコードはコマンドが見つからなかったことを意味します: テンプレートはあなたのシェルなしで実行されるため、フルパスか独自の PATH が必要です。"
          }
        }
      }
    },
    "That code means the Host's shell could not find its command.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのコードはホストのシェルがコマンドを見つけられなかったことを意味します。"
          }
        }
      }
    },
    "That file defines a moon, not a planet. Add moons to a ZeroTier network by world ID and seed instead.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのファイルはムーンを定義しています。プラネットではありません。ムーンは world ID と seed で ZeroTier ネットワークに追加してください。"
          }
        }
      }
    },
    "That file is not a ZeroTier planet. Use the planet file your roots' operator provides (as made by mkworld); it is at most 16 KB.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのファイルは ZeroTier のプラネットではありません。ルートの運営者が提供するプラネットファイル（mkworld で作成されたもの。最大 16 KB）を使用してください。"
          }
        }
      }
    },
    "That folder path cannot be opened": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのフォルダパスは開けません"
          }
        }
      }
    },
    "That option isn't on the screen any more.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その選択肢はもう画面にありません。"
          }
        }
      }
    },
    "The %@ input box is not recognized. Continue in the Agent terminal.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の入力欄を認識できません。エージェントのターミナルで続けてください。"
          }
        }
      }
    },
    "The Agent could not generate or save the title.": {
      "extractionState": "manual",
      "localizations": {
