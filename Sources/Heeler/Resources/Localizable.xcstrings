          }
        }
      }
    },
    "The %@ input box is not recognized. Continue in the Agent terminal." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ の入力欄を認識できません。エージェントのターミナルで続けてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法识别 %@ 的输入栏。请在 Agent 终端中继续操作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法辨識 %@ 的輸入框。請在 Agent 終端機中繼續。"
          }
        }
      }
    },
    "The Agent could not generate or save the title." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "エージェントはタイトルを生成または保存できませんでした。"
