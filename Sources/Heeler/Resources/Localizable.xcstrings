          "stringUnit": {
            "state": "translated",
            "value": "承認の選択肢が画面にありません。"
          }
        }
      }
    },
    "The approval's options could not be read.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認の選択肢を読み取れませんでした。"
          }
        }
      }
    },
    "The auth key could not be saved in the Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "認証キーをキーチェーンに保存できませんでした。"
          }
        }
      }
    },
    "The change failed unexpectedly. (%@)": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更に予期せず失敗しました。(%@)"
          }
        }
      }
    },
    "The change finished, but the plugin could not be read back. Run the checks again.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は完了しましたが、プラグインを読み戻せませんでした。再チェックを実行してください。"
          }
        }
      }
    },
    "The change finished, but the plugin still needs the attention described above.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更は完了しましたが、プラグインは前述の対処を必要としています。"
          }
        }
      }
    },
    "The check was cancelled before it finished.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認は完了する前に中止されました。"
          }
        }
      }
    },
    "The checkout at %@ was removed and its workspace was closed. No branch was deleted.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のチェックアウトは削除され、ワークスペースは閉じられました。ブランチは削除されていません。"
          }
        }
      }
    },
    "The checks ended before reading this Host.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストを読む前にチェックが終わりました。"
          }
        }
      }
    },
    "The classic high-contrast dark palette": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "定番の高コントラストダークパレット"
          }
        }
      }
    },
    "The classic low-contrast dark theme for both appearances": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方の外観向けの定番低コントラストダークテーマ"
          }
        }
      }
    },
    "The clipboard has no image. Copy one, then tap Paste Image.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリップボードに画像がありません。コピーしてから「画像を貼り付け」をタップしてください。"
          }
        }
      }
    },
    "The compaction was cancelled.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "圧縮はキャンセルされました。"
          }
        }
      }
    },
    "The composer shows “%@”, which Heeler does not know.": {
      "comment": "A line of text that Codex's composer shows, but which Heeler does not know.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力欄に「%@」と表示されていますが、Heeler はこれを認識できません。"
          }
        }
      }
    },
    "The config server address is missing": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定サーバーのアドレスがありません"
          }
        }
      }
    },
    "The connection changed before the message was submitted, so nothing was submitted. The text may still be in the Agent's input.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージの送信前に接続が変わったため、何も送信されませんでした。テキストはまだエージェントの入力欄にある可能性があります。"
          }
        }
      }
    },
    "The connection ended during the change, which may still finish on the Host. Run the checks again.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "変更の途中で接続が終わりました。処理はホスト側で完了している可能性があります。再チェックを実行してください。"
          }
        }
      }
    },
    "The connection is busy": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続は使用中です"
          }
        }
      }
    },
    "The connection is busy. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続がビジーです。再試行してください。"
          }
        }
      }
    },
    "The connection is paused until Heeler becomes active.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeler がアクティブになるまで接続は一時停止します。"
          }
        }
      }
    },
    "The connection to the Host failed before any Terminal ended, so nothing was removed. Try again once the Host is connected.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルが終了する前にホストとの接続が失敗したため、何も削除されませんでした。ホストの接続後に再試行してください。"
          }
        }
      }
    },
    "The connection to the Host failed.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストとの接続に失敗しました。"
          }
        }
      }
    },
    "The conversation file cannot be read": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話ファイルを読み取れません"
          }
        }
      }
    },
    "The coordination server must be an https URL. Fix it in Advanced.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーディネーションサーバーは https の URL である必要があります。「詳細設定」で修正してください。"
          }
        }
      }
    },
    "The coordination server sent a sign-in link that is not https": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調整サーバーが https でないサインインリンクを送りました"
          }
        }
      }
    },
    "The current plugin keeps its own registrations, so turn Notifications back on for this Host in Settings › Notifications afterwards.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のプラグインは自身の登録を保持するため、あとで「設定 › 通知」でこのホストの通知を再びオンにしてください。"
          }
        }
      }
    },
    "The desktop app could not be reached.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デスクトップアプリに到達できませんでした。"
          }
        }
      }
    },
    "The dialog has no title.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダイアログにタイトルがありません。"
          }
        }
      }
    },
    "The dialog holds text typed in the terminal. Finish it there; Heeler never clears it.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダイアログにはターミナルで入力されたテキストがあります。あちらで仕えてください。Heeler は決して消しません。"
          }
        }
      }
    },
    "The dialog lacks a Yes or a No option.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダイアログに Yes か No の選択肢がありません。"
          }
        }
      }
    },
    "The dialog's options are not numbered.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダイアログの選択肢に番号が付いていません。"
          }
        }
      }
    },
    "The dialog's title could not be read.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダイアログのタイトルを読み取れませんでした。"
          }
        }
      }
    },
    "The encrypted notification (ciphertext), which it forwards without decrypting.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復号せずに転送する、暗号化された通知（暗号文）。"
          }
        }
      }
    },
    "The file changed after Heeler edited it, so nothing was written. Undo the edit by hand if you still want to.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeler が編集したあとにファイルが変更されたため、書き込まれませんでした。編集を取り消したい場合は手動で行ってください。"
          }
        }
      }
    },
    "The file changed after Heeler read it, so nothing was written. Review the change again.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeler が読み取ったあとにファイルが変更されたため、書き込まれませんでした。変更をもう一度確認してください。"
          }
        }
      }
    },
    "The file is too large for Heeler to edit, so nothing was written.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルが大きすぎて Heeler は編集できないため、書き込まれませんでした。"
          }
        }
      }
    },
    "The fixed address is not valid. Fix it in Advanced.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定アドレスが有効ではありません。「詳細設定」で修正してください。"
          }
        }
      }
    },
    "The focused text field has no option next to it to step to.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォーカス中のテキストフィールドの隣に移動できる選択肢がありません。"
          }
        }
      }
    },
    "The footer shows “%@”; Heeler only sends Claude's default keys.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フッターに「%@」と表示されています。Heeler は Claude の既定のキーのみ送信します。"
          }
        }
      }
    },
    "The full URL from the server's operator, ending in your user name. %@": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの運用者から得る完全な URL で、末尾はあなたのユーザー名です。%@"
          }
        }
      }
    },
    "The generated identity is malformed": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成された ID の形式が不正です"
          }
        }
      }
    },
    "The herdr CLI was not found on the Host's non-interactive SSH PATH.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "herdr CLI がホストの非対話型 SSH PATH に見つかりませんでした。"
          }
        }
      }
    },
    "The herdr launcher at %@ could not run. Check that this launcher exists, is executable, and can start herdr. Pair the Host again if its path changed.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の herdr ランチャーを実行できませんでした。このランチャーが存在し、実行可能で、herdr を起動できるか確認してください。パスが変わった場合はホストの再ペアリングが必要です。"
          }
        }
      }
    },
    "The herdr launcher could not run": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "herdr ランチャーを実行できませんでした"
          }
        }
      }
    },
    "The herdr socket was not found": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "herdr ソケットが見つかりません"
          }
        }
      }
    },
    "The herdr-core link closed.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "herdr-core のリンクが閉じられました。"
          }
        }
      }
    },
    "The herdr-core on this Host carries it too. See the notice in the Host's details for how to fix that.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストの herdr-core にも同じ変数があるため、そちらの直し方はホストの詳細の案内を確認してください。"
          }
        }
      }
    },
    "The herdr-core socket path is too long": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "herdr-core のソケットパスが長すぎます"
          }
        }
      }
    },
    "The host key changed": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト鍵が変わりました"
          }
        }
      }
    },
    "The host key is not trusted": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホスト鍵は信頼されていません"
          }
        }
      }
    },
    "The host key was not confirmed. Run the checks again and confirm the fingerprint.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストキーは確定されませんでした。もう一度チェックを実行し、指紋を確認してください。"
          }
        }
      }
    },
    "The identifying notification details: project name, task title, agent type and name, Host name, pane ID, and per-agent details.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知の識別情報: プロジェクト名、タスクタイトル、エージェントの種類と名前、ホスト名、ペイン ID、エージェントごとの詳細。"
          }
        }
      }
    },
    "The image changed while loading. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込み中に画像が変わったため、もう一度お試しください。"
          }
        }
      }
    },
    "The image could not be reduced below the 16 MiB upload limit.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像を 16 MiB のアップロード制限未満まで縮小できませんでした。"
          }
        }
      }
    },
    "The key could not be removed from the Keychain. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーをキーチェーンから削除できませんでした。再試行してください。"
          }
        }
      }
    },
    "The key could not be saved in the Keychain.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーをキーチェーンに保存できませんでした。"
          }
        }
      }
    },
    "The last change here is still being saved. Try again in a moment.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでの最後の変更はまだ保存中です。少ししてから再試行してください。"
          }
        }
      }
    },
    "The last message may still be in the Agent's input, so nothing was sent. Check the terminal, then send again.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "直前のメッセージがまだエージェントの入力欄にある可能性があるため、何も送信しませんでした。ターミナルを確認してから再送信してください。"
          }
        }
      }
    },
    "The link to %@ couldn't be opened. You can copy it instead.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ へのリンクを開けませんでした。代わりにコピーできます。"
          }
        }
      }
    },
    "The machine did not answer. Check that it is on and on this network.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンは応答しませんでした。電源が入っており、このネットワークにいることを確認してください。"
          }
        }
      }
    },
    "The machine did not give an IP address. Type its address instead.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシンは IP アドレスを返しませんでした。代わりにアドレスを入力してください。"
          }
        }
      }
    },
    "The machine name is resolved through MagicDNS and follows the machine if its address changes.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マシン名は MagicDNS で解決され、アドレスが変わってもマシンについて回ります。"
          }
        }
      }
    },
    "The message contains terminal control characters.": {
      "comment": "Error message when a message contains terminal control characters.",
      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージにターミナルの制御文字が含まれています。"
          }
        }
      }
    },
    "The message contains unsafe terminal control characters.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメッセージには安全でないターミナル制御文字が含まれています。"
          }
        }
      }
    },
    "The message could not be sent. Check the connection and retry.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージを送信できませんでした。接続を確認して再試行してください。"
          }
        }
      }
    },
    "The microphone is in use or unavailable.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクは使用中か、利用できません。"
          }
        }
      }
    },
    "The model stopped at its output limit.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが出力上限で停止しました。"
          }
        }
      }
    },
    "The named pipe %@ does not exist": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前付きパイプ %@ が存在しません"
          }
        }
      }
    },
    "The network could not be deleted.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークを削除できませんでした。"
          }
        }
      }
    },
    "The network did not answer in time.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークは時間内に応答しませんでした。"
          }
        }
      }
    },
    "The network is not connected": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネットワークが接続されていません"
          }
        }
      }
    },
    "The network is not ready yet": {
      "extractionState": "manual",
      "localizations": {
