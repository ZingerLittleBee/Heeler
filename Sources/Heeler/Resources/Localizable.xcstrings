    "This layout could not be saved. Use at most 3 rows and 16 fields per row, with valid field names." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このレイアウトは保存できませんでした。最大 3 行・1 行あたり 16 フィールドまで、有効なフィールド名を使ってください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法保存此布局。请使用有效字段名，且最多设置 3 行、每行最多 16 个字段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
