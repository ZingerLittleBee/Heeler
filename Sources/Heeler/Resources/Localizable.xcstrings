            "value" : "此主机的 git 版本为 %@。“更改”功能需要 git 2.17 或更高版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此主機的 git 版本為 %@。「變更」功能需要 git 2.17 或更新版本。"
          }
        }
      }
    },
    "This Host has neither sha256sum nor shasum, so Heeler cannot check the Host Helper's files." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストには sha256sum も shasum もないため、Heeler は Host Helper のファイルを検証できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
