    },
    "Jump Host key changed: trusted %@, it presented %@. This can be a reinstalled server or an attack — verify with its owner before trusting it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジャンプホストのホスト鍵が変更されました: 信頼済み %@、提示されたのは %@。再インストールされたサーバーか攻撃の可能性があります。信頼する前に所有者に確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳板机密钥已更改：已信任 %@，而其出示的是 %@。这可能是因为服务器重装，也可能是遭受了攻击——请先向其所有者核实，再决定是否信任。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跳板主機金鑰已變更：原本信任 %@，現在出示的是 %@。這可能是伺服器重新安裝，也可能是遭到攻擊——請先向擁有者確認，再決定是否信任。"
          }
        }
      }
    },
