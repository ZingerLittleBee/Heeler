    "%@ If an admin must approve this device, authorize it in the network's admin console." : {
      "comment" : "Overlay failure explanation. %@ is the overlay's own detail sentence, which may be English.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 管理者がこのデバイスの承認を必要とする場合は、ネットワークの管理コンソールで承認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 如果需要管理员批准此设备，请在该网络的管理控制台中予以授权。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 如果需要管理員核准此裝置，請在網路的管理主控台中授權。"
          }
        }
      }
    },
    "%@ See this Host's page in Hosts." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ このホストのページを「ホスト」タブで確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 请在“主机”标签页中查看此主机的页面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 請到「主機」中查看此主機的頁面。"
          }
        }
      }
    },
    "%@ Transcript or folder could not be read. It is retried on the next refresh." : {
      "localizations" : {
