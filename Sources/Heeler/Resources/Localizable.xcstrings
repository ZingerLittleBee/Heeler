      }
    },
    "Use 120 characters or fewer." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "120 文字以内で入力してください。"
          }
        }
      }
    },
    "Use Automatic for mixed speech. This service accepts one language; results depend on its model." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "混合された発話には「自動」を使ってください。このサービスは 1 つの言語のみ受け付け、結果はモデルに依存します。"
          }
        }
      }
    },
    "Use This Conversation" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この会話を使用"
          }
        }
      }
    },
    "Use ZeroTier's Planet" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ZeroTier のプラネットを使用"
          }
        }
      }
    },
    "Use a shorter core session name, or set a shorter socket in the core's config." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "より短いコアセッション名を使うか、コアの設定でより短いソケットを指定してください。"
          }
        }
      }
    },
    "Use a single line without control characters." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
