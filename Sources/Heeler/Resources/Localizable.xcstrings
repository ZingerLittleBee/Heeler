        }
      }
    },
    "Heeler answers only Oh My Pi's single-select questions. Answer this one in the terminal.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeler は Oh My Pi の単一選択の質問にのみ回答します。この質問にはターミナルで回答してください。"
          }
        }
