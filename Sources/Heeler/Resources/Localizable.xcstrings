    "Hosts Unavailable" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストを利用できません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机不可用"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "多個主機無法使用"
          }
        }
      }
    },
    "Hosts connect their network on their own; the switch keeps one connected. Heeler joins without turning on a VPN, and a network stays connected only while Heeler is open." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストは各自でネットワークに接続します。このスイッチは 1 つを接続したままに保ちます。Heeler は VPN をオンにせずに参加し、ネットワークは Heeler が開いている間だけ接続を保ちます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机需要某网络时会自动连接；打开开关可使其保持连接。Heeler 无需开启 VPN 即可加入网络，且网络仅在 Heeler 打开期间保持连接。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機會自行連上網路；開關可讓其中一個保持連線。Heeler 加入網路時無需開啟 VPN，且網路只在 Heeler 開啟期間保持連線。"
          }
        }
      }
    },
    "Hosts on %@ stay disconnected until you sign in again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のホストは、再サインインするまで接続されないままです。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新登录前，%@ 上的主机将保持断开状态。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在你重新登入前，%@ 上的主機會保持未連線。"
          }
        }
      }
    },
    "Hosts on this network wait for it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このネットワーク上のホストはこれを待ちます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此网络的主机正在等待其就绪。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此網路的主機會等待它連線。"
          }
        }
      }
    },
    "Hosts that use this network stop connecting until you choose another network for them." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このネットワークを使うホストは、他のネットワークを選ぶまで接続しなくなります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用此网络的主机将停止连接，直到你为它们选择其他网络。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
