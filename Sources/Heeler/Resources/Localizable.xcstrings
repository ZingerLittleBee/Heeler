          }
        }
      }
    },
    "The Agent left the terminal before the message was submitted, so nothing was submitted. The text may still be in the terminal.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージの送信前にエージェントがターミナルを離れたため、何も送信されませんでした。テキストはまだターミナル内にある可能性があります。"
          }
        }
      }
    },
    "The Agent no longer holds this terminal, so Heeler pressed nothing.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
