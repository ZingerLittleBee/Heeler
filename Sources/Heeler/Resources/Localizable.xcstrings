      }
    },
    "The Host does not accept RSA-SHA2-512" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストは RSA-SHA2-512 を受け付けません"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机不接受 RSA-SHA2-512"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機不接受 RSA-SHA2-512"
          }
        }
      }
    },
    "The Host does not offer RSA-SHA2-512 signatures, which RSA Key requires. Registering the key again will not help; enable rsa-sha2-512 on the Host or choose another authentication method." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストは RSA 鍵が必要とする RSA-SHA2-512 署名を提供していません。鍵を再登録しても改善しません。ホストで rsa-sha2-512 を有効にするか、別の認証方式を選んでください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机不支持 RSA 密钥所需的 RSA-SHA2-512 签名。重新注册密钥无法解决此问题；请在主机上启用 rsa-sha2-512，或选择其他认证方式。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機不提供 RSA 金鑰所需的 RSA-SHA2-512 簽章。重新註冊金鑰沒有幫助；請在主機上啟用 rsa-sha2-512，或選擇其他驗證方式。"
          }
        }
      }
    },
    "The Host has Node.js %@ but no npm, so nothing changed. Install npm (a separate package on Debian and Ubuntu), then try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストには Node.js %@ はありますが npm がないため、変更は行われていません。npm（Debian と Ubuntu では別パッケージ）をインストールしてから、再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机已安装 Node.js %@，但缺少 npm，因此未做任何更改。请先安装 npm（在 Debian 和 Ubuntu 上为独立软件包），然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機有 Node.js %@，但沒有 npm，因此沒有任何變更。請安裝 npm（在 Debian 和 Ubuntu 上是獨立套件），然後再試一次。"
          }
        }
      }
    },
    "The Host has no pairing in progress for this code. Generate a new Pairing Code on the computer and scan it." : {
