    "Default is the folder %@ picks itself. A Launch Preset with an Account sets %@ to its folder." : {
      "comment" : "Accounts footer. %1$@ is the harness name, %2$@ its folder environment variable.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既定は %1$@ が自分で選ぶフォルダです。アカウントを指定した起動プリセットは、%2$@ をそのフォルダに設定します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认使用 %@ 自行选择的文件夹。指定了账户的启动预设会将 %@ 设为该账户的文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設為 %@ 自行選用的資料夾。帶有帳號的啟動預設集會將 %@ 設為該帳號的資料夾。"
          }
        }
      }
    },
    "Default is the folder %@ picks itself. Name the variable %@ reads its folder from to launch an Account." : {
      "comment" : "Accounts footer when no folder variable is set. Both arguments are the harness name.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既定は %1$@ が自分で選ぶフォルダです。アカウントで起動するには、%2$@ がフォルダを読み取る変数の名前を指定してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认使用 %@ 自行选择的文件夹。若要使用指定账户启动，请填写 %@ 用于读取文件夹的环境变量名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設為 %@ 自行選用的資料夾。請填入 %@ 讀取資料夾位置所用的變數名稱，才能啟動帳號。"
          }
        }
      }
    },
    "Default is the folder %@ uses in herdr’s environment. It can be renamed, not removed. A Launch Preset with an Account sets %@ to its folder." : {
      "comment" : "Accounts footer. %1$@ is the harness name, %2$@ its folder environment variable.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既定は %1$@ が herdr の環境で使うフォルダです。名前変更はできますが、削除はできません。アカウントを指定した起動プリセットは、%2$@ をそのフォルダに設定します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认使用 %@ 在 herdr 环境中使用的文件夹。默认账户可重命名，但不可移除。指定了账户的启动预设会将 %@ 设为该账户的文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設為 %@ 在 herdr 環境中使用的資料夾，可重新命名，但無法移除。帶有帳號的啟動預設集會將 %@ 設為該帳號的資料夾。"
          }
        }
      }
    },
    "Default is the folder %@ uses in herdr’s environment. It can be renamed, not removed. Name the variable %@ reads its folder from to launch an Account." : {
      "comment" : "Accounts footer when no folder variable is set. Both arguments are the harness name.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "既定は %1$@ が herdr の環境で使うフォルダです。名前変更はできますが、削除はできません。アカウントで起動するには、%2$@ がフォルダを読み取る変数の名前を指定してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "默认使用 %@ 在 herdr 环境中使用的文件夹。默认账户可重命名，但不可移除。若要使用指定账户启动，请填写 %@ 用于读取文件夹的环境变量名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "預設為 %@ 在 herdr 環境中使用的資料夾，可重新命名，但無法移除。請填入 %@ 讀取資料夾位置所用的變數名稱，才能啟動帳號。"
          }
        }
      }
    },
