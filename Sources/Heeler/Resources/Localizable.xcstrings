    "%@ is no longer a Template on this Host, so nothing started. Detect Again refreshes the list." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ はこのホストのテンプレートでなくなったため、何も起動しませんでした。「再検出」でリストを更新できます。"
          }
        }
      }
    },
    "%@ is no longer a Template on this Host, so the core ran a program of that name in a Terminal at %@. Close it if you did not mean to run it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ はこのホストのテンプレートでなくなったため、コアは同名のプログラムを %2$@ のターミナルで実行しました。意図したものでなければ閉じてください。"
          }
        }
      }
    },
    "%@ is not a variable name." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は変数名ではありません。"
          }
