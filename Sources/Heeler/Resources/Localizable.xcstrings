    "%@ changed (binary, mode only or too large to show)": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が変更されました（バイナリ、モード変更のみ、または表示には大きすぎる）"
