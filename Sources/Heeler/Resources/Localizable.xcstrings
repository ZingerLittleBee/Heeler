    "Hosts" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホスト"
          }
        }
      }
    },
    "Hosts Unavailable" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストを利用できません"
          }
        }
      }
    },
    "Hosts connect their network on their own; the switch keeps one connected. Heeler joins without turning on a VPN, and a network stays connected only while Heeler is open." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストは各自でネットワークに接続します。このスイッチは 1 つを接続したままに保ちます。Heeler は VPN をオンにせずに参加し、ネットワークは Heeler が開いている間だけ接続を保ちます。"
          }
        }
      }
    },
    "Hosts on %@ stay disconnected until you sign in again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ のホストは、再サインインするまで接続されないままです。"
          }
        }
      }
    },
    "Hosts on this network wait for it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このネットワーク上のホストはこれを待ちます。"
          }
        }
      }
    },
    "Hosts that use this network stop connecting until you choose another network for them." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このネットワークを使うホストは、他のネットワークを選ぶまで接続しなくなります。"
