    "Tailscale" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale"
          }
        }
      }
    },
    "Tailscale SSH answers port %lld at %@, not OpenSSH, so this device cannot be enrolled there. On the computer, set ssh_port in the pairing plugin's pair.json to a port OpenSSH listens on, then generate a new Pairing Code." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale SSH は %2$@ のポート %1$lld に答えます。OpenSSH ではないため、このデバイスをそこで登録することはできません。コンピューターで、ペアリングプラグインの pair.json の ssh_port を OpenSSH がリッスンしているポートに設定し、新しいペアリングコードを生成してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$@ 的端口 %1$lld 由 Tailscale SSH 响应，而非 OpenSSH，因此无法在该端口注册此设备。请在电脑上将配对插件 pair.json 中的 ssh_port 设为 OpenSSH 监听的端口，然后生成新的配对码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tailscale SSH 在 %2$@ 的連接埠 %1$lld 上回應，而不是 OpenSSH，因此無法在那裡註冊此裝置。請在電腦上將配對外掛 pair.json 中的 ssh_port 設為 OpenSSH 所監聽的連接埠，然後產生新的配對碼。"
          }
        }
      }
    },
    "Take Over" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "引き継ぐ"
