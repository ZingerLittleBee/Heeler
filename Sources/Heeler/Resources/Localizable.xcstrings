    "\"%@\" leaves no folder name for the checkout. Use a branch with ASCII letters or digits in it.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」からはチェックアウト用のフォルダ名が作れません。ASCII の英数字を含むブランチを使ってください。"
          }
        }
      }
    },
