      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Herdr TUI"
          }
        }
      }
    },
    "Herdr's agent hooks report to the pane this names, not to the Terminal they run in.": {
      "extractionState": "manual",
      "localizations": {
