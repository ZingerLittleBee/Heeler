          }
        }
      }
    },
    "Heeler answers only a single question Grok Build asks during its turn. Answer this one with these keys or in the terminal.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeler は Grok Build がターン中に尋ねる単一の質問にのみ回答します。これらのキーまたはターミナルで回答してください。"
          }
