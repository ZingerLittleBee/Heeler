      }
    },
    "The Host refused to change the folder %@." : {
      "comment" : "Argument: a folder path on the Host.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストはフォルダ %@ の変更を拒否しました。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机拒绝更改文件夹 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機拒絕變更資料夾 %@。"
          }
        }
      }
    },
    "The Host rejected the RSA Key. Copy its public key from Edit Host and register it wherever that Host accepts SSH identities." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストは RSA 鍵を拒否しました。「ホストを編集」から公開鍵をコピーし、そのホストが SSH の ID を受け付ける場所に登録してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机拒绝了 RSA 密钥。请在“编辑主机”中拷贝其公钥，并将其注册到该主机接受 SSH 公钥的位置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機拒絕了 RSA 金鑰。請從「編輯主機」複製其公開金鑰，並在該主機接受 SSH 身分的任何位置註冊。"
          }
        }
      }
    },
    "The Host rejected the device key. Copy this Host's key line into ~/.ssh/authorized_keys on the Host, or for an administrator account on Windows into C:\\ProgramData\\ssh\\administrators_authorized_keys, which only Administrators and SYSTEM may access, then run the checks again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストはデバイス鍵を拒否しました。このホストの鍵行をホストの ~/.ssh/authorized_keys にコピーしてください。Windows の管理者アカウントの場合は C:\\ProgramData\\ssh\\administrators_authorized_keys にコピーし（アクセスできるのは Administrators と SYSTEM のみ）、再チェックを実行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机拒绝了设备密钥。请将此主机的公钥行拷贝到主机的 ~/.ssh/authorized_keys 中（Windows 管理员账户则拷贝到仅允许 Administrators 和 SYSTEM 访问的 C:\\ProgramData\\ssh\\administrators_authorized_keys 中），然后重新运行检查。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機拒絕了裝置金鑰。請將此主機的金鑰行複製到主機上的 ~/.ssh/authorized_keys；Windows 系統管理員帳號則複製到 C:\\ProgramData\\ssh\\administrators_authorized_keys（僅限 Administrators 和 SYSTEM 存取），然後再次執行檢查。"
          }
        }
      }
    },
    "The Host rejected the login. Check the username and password." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストはログインを拒否しました。ユーザー名とパスワードを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机拒绝了登录。请检查用户名和密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機拒絕登入。請檢查使用者名稱和密碼。"
          }
        }
      }
    },
    "The Host rejected this Pairing Code. It may have been used already, expired, or its popup was closed. Generate a new Pairing Code on the computer and scan it." : {
      "comment" : "Pairing failure",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストはこのペアリングコードを拒否しました。すでに使用されたか、期限切れか、ポップアップが閉じられた可能性があります。コンピューターで新しいペアリングコードを生成してスキャンしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机拒绝了此配对码。该配对码可能已被使用、已过期，或其弹窗已被关闭。请在电脑上生成新的配对码并扫描。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機拒絕了此配對碼。它可能已被使用、已過期，或其快顯視窗已關閉。請在電腦上產生新的配對碼並掃描。"
          }
        }
      }
    },
    "The Host speaks herdr protocol %lld; this app needs at least %lld. %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストは herdr プロトコル %1$lld で通信しており、このアプリは少なくとも %2$lld を必要とします。%3$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机使用的是 herdr 协议 %lld，而此 App 至少需要版本 %lld。%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機使用 herdr 協定 %lld；此 App 至少需要 %lld。%@"
          }
        }
      }
    },
    "The Host took too long to read Changes. Pull to try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストが変更の読み取りに時間をかけすぎました。引いて再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
