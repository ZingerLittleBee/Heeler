            "value": "「%@」を実行中のペインを閉じます。タブ内の他のペインは開いたままです。"
          }
        }
      }
    },
    "Closes the tab running “%@”.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」を実行中のタブを閉じます。"
          }
        }
      }
    },
    "Closes this pane of %@ in %@. The tab's other panes stay open.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
