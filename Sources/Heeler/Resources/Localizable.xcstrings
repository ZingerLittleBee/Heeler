          }
        }
      }
    },
    "It may still complete. Check the Terminal before trying again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "完了している可能性があります。再試行の前にターミナルを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
