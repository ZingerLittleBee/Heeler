          "stringUnit": {
            "state": "translated",
            "value": "エージェントはいなくなりました。%@"
          }
        }
      }
    },
    "The Agent is no longer idle.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはもうアイドルではありません。"
          }
        }
      }
    },
    "The Agent is no longer listed.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはもう一覧にありません。"
          }
        }
