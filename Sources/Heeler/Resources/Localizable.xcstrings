    "This machine only gave a link-local IPv6 address. Enter its IPv4 address by hand." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このマシンはリンクローカルな IPv6 アドレスしか返しませんでした。IPv4 アドレスを手入力してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
