    },
    "The dialog didn't respond the way Heeler expected, so it stopped. Finish here or in the terminal." : {
      "comment" : "Blocked card notice after an answer's keys didn't get the expected screen",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダイアログが Heeler の想定どおりに応答しなかったため、停止しました。ここかターミナルで完了してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对话框未按 Heeler 预期响应，因此已停止。请在此处或终端中完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
