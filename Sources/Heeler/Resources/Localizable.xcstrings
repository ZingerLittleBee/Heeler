    },
    "The Node.js Heeler found on the Host is %@, and the plugin needs %lld or newer, so nothing changed. Install a newer version or make it the default, then try again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeler が見つけたホストの Node.js は %@ で、プラグインは %lld 以上を必要とするため、変更は行われていません。新しいバージョンをインストールするか既定に設定してから、再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeler 在主机上找到的 Node.js 版本为 %@，而插件需要 %lld 或更高版本，因此未做任何更改。请安装更高版本或将其设为默认版本，然后重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeler 在主機上找到的 Node.js 為 %@，而外掛需要 %lld 或更新版本，因此沒有任何變更。請安裝較新的版本或將其設為預設，然後再試一次。"
          }
