        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在启动后立即退出（退出码 127），因此当前没有运行中的 Agent。%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 啟動後隨即結束（結束代碼 127），因此沒有 Agent 在執行。%@"
