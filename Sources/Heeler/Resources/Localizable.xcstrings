        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機的 Claude Code 或 Codex 用量上限與重設時間。"
          }
        }
      }
    },
    "A Shell Terminal on this Host is open in another Heeler window, and input continues there. Close it to use the terminal here." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このホストのシェルターミナルが別の Heeler ウィンドウで開いており、入力はあちらで続いています。ここで使うにはあちらを閉じてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此主机上的一个 Shell 终端已在另一个 Heeler 窗口中打开，输入将在该窗口继续。关闭该窗口即可在此处使用终端。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此主機上的 Shell 終端機已在另一個 Heeler 視窗中開啟，輸入會在該處繼續。請先關閉它，才能在這裡使用終端機。"
          }
        }
      }
    },
    "A Snippet can hold at most %lld characters." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スニペットは最大 %lld 文字まで保存できます。"
