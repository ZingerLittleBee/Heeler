    "Usage Limits are shown per Host. Two Hosts signed in to the same account show the same windows." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用量制限はホストごとに表示されます。同じアカウントでサインインしている 2 つのホストは同じ期間区分を表示します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用量限额按主机分别显示。登录同一账户的两台主机会显示相同的限额周期。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
