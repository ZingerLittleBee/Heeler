        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無法讀取 planet 檔案。"
          }
        }
      }
    },
    "The plugin asks Claude Code on this computer for your plan limits. Neither the plugin nor Heeler handles your sign-in. This automated use is not officially supported." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プラグインは、このコンピューター上の Claude Code にプラン上限を尋ねます。プラグインも Heeler もサインインの処理には関与しません。この自動的な利用は公式にはサポートされていません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "插件会向这台电脑上的 Claude Code 查询你的套餐限额。插件和 Heeler 都不会处理你的登录信息。此自动化调用方式并非官方支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "外掛會向這台電腦上的 Claude Code 詢問你的方案用量上限。外掛和 Heeler 都不會處理你的登入。這種自動化用法未獲官方支援。"
          }
        }
      }
    },
