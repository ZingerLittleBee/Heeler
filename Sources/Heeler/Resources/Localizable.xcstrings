          "stringUnit": {
            "state": "translated",
            "value": "エージェントがメッセージの送信前に終了したため、送信されませんでした。"
          }
        }
      }
    },
    "The Agent ended. %@": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが終了しました。%@"
          }
        }
      }
    },
    "The Agent has ended, so nothing was sent.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは終了しているため、送信されませんでした。"
          }
        }
      }
    },
    "The Agent hasn't reported its conversation. Open Chat and check its session before renaming.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
