          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@ 内の %2$@ に \"%1$@\" を追加し、そのファイルの隣にその名前のフォルダを作って Heeler のプラグインのコピーを置きます。"
          }
        }
      }
    },
    "Add \"%@\" to %@ inside %@ in %@, not at the top of the file, where a list would replace the one inside %@, with a copy of Heeler's plugin in a folder of that name beside the file." : {
      "comment" : "Entry, list key, section, file name, section",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%4$@ 内の %3$@ 内の %2$@ に \"%1$@\" を追加し、そのファイルの隣にその名前のフォルダを作って Heeler のプラグインのコピーを置きます。ファイルの先頭に置くと、そのリストが %5$@ 内のリストを置き換えてしまいます。"
          }
        }
      }
