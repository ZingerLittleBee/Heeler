          "stringUnit" : {
            "state" : "translated",
            "value" : "對話框沒有標題。"
          }
        }
      }
    },
    "The dialog holds text typed in the terminal. Finish it there; Heeler never clears it." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダイアログにはターミナルで入力されたテキストがあります。そちらで完了してください。Heeler がそれを消すことはありません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
