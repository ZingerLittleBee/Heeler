    "%@ could not use this Mac’s keychain. Start herdr from a terminal on the Mac, then refresh." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ はこの Mac のキーチェーンを利用できませんでした。Mac 上のターミナルから herdr を起動し、再読み込みしてください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法使用这台 Mac 的钥匙串。请在这台 Mac 的终端中启动 herdr，然后刷新。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 無法使用這台 Mac 的鑰匙圈。請在 Mac 上的終端機中啟動 herdr，然後重新整理。"
          }
        }
      }
    },
    "%@ couldn't compact." : {
      "comment" : "%@ is a program name",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は圧縮できませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 无法执行压缩。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 無法壓縮對話。"
          }
        }
      }
    },
    "%@ ended right after it started, so no Agent is running." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ は起動直後に終了したため、実行中のエージェントはいません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在启动后立即退出，因此当前没有运行中的 Agent。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 啟動後隨即結束，因此沒有 Agent 在執行。"
          }
        }
      }
    },
    "%@ ended right after it started, with exit code %lld, so no Agent is running." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は起動直後に終了しました（終了コード %2$lld）。実行中のエージェントはいません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 在启动后立即退出（退出码 %lld），因此当前没有运行中的 Agent。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 啟動後隨即結束（結束代碼 %lld），因此沒有 Agent 在執行。"
          }
        }
      }
    },
    "%@ ended right after it started, with exit code 127, so no Agent is running. %@" : {
