      }
    },
    "The options do not start at 1, so the list may be scrolled." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択肢が1から始まらないため、リストがスクロールしている可能性があります。"
          }
        }
      }
    },
    "The other %lld Hosts' rows, right sides included, are replaced with %@'s and saved right away. Changes you make here later stay on %@." : {
      "comment" : "Apply to other Hosts confirmation. %1$lld is the other Host count; %2$@ and %3$@ are this Host's name.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他の %1$lld 台のホストの行（右側を含む）は %2$@ の行に置き換えられ、すぐに保存されます。この後ここで行う変更は %3$@ にだけ反映されます。"
          }
        }
      }
    },
    "The other Host's rows, right sides included, are replaced with %@'s and saved right away. Changes you make here later stay on %@." : {
      "comment" : "Apply to other Hosts confirmation. Both arguments are this Host's name.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他のホストの行（右側を含む）は %1$@ の行に置き換えられ、すぐに保存されます。この後ここで行う変更は %2$@ にだけ反映されます。"
          }
        }
      }
    },
    "The panel has no such action." : {
      "comment" : "Planner refusal for Grok Build's subagent panel",
      "localizations" : {
