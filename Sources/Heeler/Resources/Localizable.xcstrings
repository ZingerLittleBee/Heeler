        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機未確認收到圖片。重試會再送出一份副本。"
          }
        }
      }
    },
    "The Host did not confirm the launch. The Agent may still have started, so check the Host before trying again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストから起動の完了応答がありませんでした。エージェントは起動している可能性があるため、再試行の前にホストを確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机未确认启动是否完成。Agent 可能已经启动，请先检查主机状态，再行重试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機未確認啟動。Agent 可能仍已啟動，請先檢查主機再重試。"
          }
        }
      }
    },
    "The Host did not confirm the rename." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストから名前変更の完了応答がありませんでした。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主机未确认重命名。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "主機未確認重新命名。"
          }
        }
      }
    },
    "The Host did not confirm the rename. It may still apply, so check the desktop app before trying again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストから名前変更の完了応答がありませんでした。適用されている可能性があるため、再試行の前にデスクトップアプリを確認してください。"
