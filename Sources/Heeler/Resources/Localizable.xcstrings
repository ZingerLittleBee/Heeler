      "isCommentAutoGenerated": true,
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode の入力ボックスを認識できません。"
          }
        }
      }
    },
    "OpenCode's prompt is in shell mode, where Esc only leaves it. Stop it in the terminal.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenCode の入力はシェルモードで、Esc はそこから抜けるだけです。ターミナルで停止してください。"
