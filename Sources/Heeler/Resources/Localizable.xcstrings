      }
    },
    "The request settings could not be saved." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエスト設定を保存できませんでした。"
          }
        }
      }
    },
    "The response has neither a result nor an error." : {
      "comment" : "Detail of a connection error.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "応答に結果もエラーもありません。"
          }
        }
      }
    },
    "The response is not JSON-RPC 2.0 for the requested id." : {
      "comment" : "Detail of a connection error.",
