          }
        }
      }
    },
    "This device" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイス"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置"
          }
        }
      }
    },
    "This device cannot scan QR codes. Paste a Pairing Code, or add the Host manually instead." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスは QR コードをスキャンできません。ペアリングコードを貼り付けるか、ホストを手動で追加してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备无法扫描二维码。请改为粘贴配对码，或手动添加主机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置無法掃描 QR Code。請貼上配對碼，或改為手動新增主機。"
          }
        }
      }
    },
    "This device gets a new one when it next connects a ZeroTier network. An admin who authorized this one has to authorize the new one." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスは、次に ZeroTier ネットワークへ接続するときに新しい ID を取得します。現在の ID を認可した管理者は、新しい ID も認可する必要があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备下次连接 ZeroTier 网络时会获取新的节点 ID。此前已授权当前 ID 的管理员需要重新授权新 ID。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置下次連接 ZeroTier 網路時會取得新的身分，曾授權此裝置的管理員必須重新授權。"
          }
        }
      }
    },
    "This device is logged out of the tailnet and its login is deleted. Hosts using this network disconnect and stay disconnected until you tap Sign In here, which signs in automatically if an auth key is saved." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このデバイスはテイルネットからサインアウトされ、ログインは削除されています。このネットワークを使うホストは、ここで「サインイン」を押すまで接続されないままです。認証キーが保存されていれば自動的にサインインします。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此设备将退出 tailnet 且其登录信息会被删除。使用此网络的主机将断开连接，并在你在此处轻点“登录”前保持断开；如果已保存授权密钥，则会自动登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此裝置會登出 tailnet，並刪除其登入資訊。使用此網路的主機會中斷連線，並維持中斷，直到你在這裡點「登入」；若已儲存驗證金鑰，會自動登入。"
          }
        }
      }
    },
    "This device is signed out of overlay network “%@”" : {
