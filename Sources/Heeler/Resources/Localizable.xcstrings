    "A Host’s Claude Code or Codex Usage Limits and when they reset.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホストの Claude Code / Codex の使用量制限と、そのリセット時期を表示します。"
          }
        }
      }
    },
    "A Shell Terminal on this Host is open in another Heeler window, and input continues there. Close it to use the terminal here.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このホストのシェルターミナルが別の Heeler ウィンドウで開いており、入力はあちらで続いています。ここで使うにはあちらを閉じてください。"
          }
        }
      }
    },
    "A Snippet can hold at most %lld characters.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
