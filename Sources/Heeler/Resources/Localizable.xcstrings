        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode 的資料庫讀取程式以狀態 %d 結束。"
          }
        }
      }
    },
    "OpenCode's default database has no conversation with this id. This Host also has %@, which other OpenCode builds use; Chat reads only the default database." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenCode の既定のデータベースに、この id の会話がありません。このホストには %@ もありますが、これらは他の OpenCode ビルドが使うもので、チャットは既定のデータベースのみを読み取ります。"
