          }
        }
      }
    },
    "This machine runs both. A Host is one kind: confirm one here, then add the machine again for the other.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシンは両方を動作させています。ホストはどちらか 1 種類です。ここでは 1 つを確定し、もう 1 つのためにこのマシンを再追加してください。"
          }
        }
      }
    },
    "This may be another terminal's conversation.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは他のターミナルの会話の可能性があります。"
          }
        }
      }
    },
    "This message is too large to show in Chat.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このメッセージは大きくて Chat に表示できません。"
          }
        }
      }
    },
    "This output is too long to show here.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この出力は長すぎてここには表示できません。"
          }
