    "Compare the new key with what the command prints on the Host first. A changed key can indicate a reinstalled Host or an attack." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しい鍵を、ホスト上でコマンドが表示する値と比較してください。鍵が変わったのは、ホストの再インストールまたは攻撃の可能性があります。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请先将新密钥与该命令在主机上输出的结果进行比对。密钥发生变化可能意味着主机已重装或遭受了攻击。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
