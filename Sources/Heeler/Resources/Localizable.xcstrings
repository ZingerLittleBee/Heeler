    },
    "%@ Check the network's settings." : {
      "comment" : "Overlay failure explanation. %@ is the overlay's own detail sentence, which may be English.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ネットワークの設定を確認してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 请检查该网络的设置。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 請檢查此網路的設定。"
          }
        }
      }
    },
    "%@ Check the title in Terminal before trying again." : {
      "comment" : "Rename outcome unknown; %@ is the full reason sentence",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ターミナルでタイトルを確認してから再試行してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 请在终端中检查标题后再试。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 請先在終端機中檢查標題，再重試一次。"
          }
        }
      }
    },
    "%@ Edit the network to fix it." : {
      "comment" : "Overlay failure explanation. %@ is the overlay's own detail sentence, which may be English.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ネットワークを編集して直してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 请编辑该网络以修正问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 請編輯此網路以修正問題。"
          }
        }
      }
    },
    "%@ Finish here or in the terminal." : {
      "comment" : "Blocked card notice; %@ is a whole sentence saying why the card stopped",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ここかターミナルで完了してください。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 请在此处或终端中完成。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 請在此處或終端機中完成。"
          }
        }
      }
    },
    "%@ Hosts" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 台のホスト"
          }
