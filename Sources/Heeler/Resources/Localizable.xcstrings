    },
    "The encrypted notification (ciphertext), which it forwards without decrypting." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復号せずに転送する、暗号化された通知（暗号文）。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加密后的通知（密文），中继会直接转发而不解密。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "加密的通知（密文），轉送時不會解密。"
          }
        }
      }
    },
    "The environment variable %@ reads its settings folder from. Launch Presets set it to an Account’s folder." : {
      "comment" : "Folder Variable alert message. %@ is the harness name.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ が設定フォルダを読み取る環境変数です。起動プリセットはこの変数をアカウントのフォルダに設定します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 用于读取其设置文件夹的环境变量。启动预设会将其设为账户的文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 用來讀取其設定資料夾的環境變數。啟動預設集會將它設為某個帳號的資料夾。"
          }
        }
      }
    },
    "The environment variable %@ reads its settings folder from. Left empty, Heeler uses %@." : {
      "comment" : "Folder Variable alert message. %1$@ is the harness name, %2$@ the default variable name.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ が設定フォルダを読み取る環境変数です。空欄の場合、Heeler は %2$@ を使います。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 用于读取其设置文件夹的环境变量。留空时，Heeler 会使用 %@。"
