    "This permanently deletes the Host configuration, its trusted host key, and any saved password from the Keychain." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはホスト設定とその信頼済みホスト鍵、そしてキーチェーン内の保存済みパスワードを恒久的に削除します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将从钥匙串中永久删除主机配置、其受信任的主机密钥以及任何已保存的密码。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會永久刪除主機設定、其信任的主機金鑰，以及鑰匙圈中任何已儲存的密碼。"
          }
        }
      }
    },
    "This permanently deletes the Host configuration, its trusted host key, any saved password, and the Notification Key from the Keychain." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはホスト設定とその信頼済みホスト鍵、保存済みパスワード、そしてキーチェーン内の通知鍵を恒久的に削除します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这将从钥匙串中永久删除主机配置、其受信任的主机密钥、任何已保存的密码以及通知密钥。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這會永久刪除主機設定、其信任的主機金鑰，以及鑰匙圈中任何已儲存的密碼和通知金鑰。"
          }
        }
      }
    },
