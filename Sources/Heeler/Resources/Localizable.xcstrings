        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[OpenCode 截断了此输出。完整输出仍保存在主机上。]"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "[OpenCode 已縮短此輸出，完整輸出保留在主機上。]"
          }
        }
      }
