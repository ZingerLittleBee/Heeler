          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "訊息送出前連線已變更，因此沒有送出任何內容。文字可能仍在 Agent 的輸入框中。"
          }
        }
      }
    },
    "The connection ended during the change, which may still finish on the Host. Run the checks again." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
