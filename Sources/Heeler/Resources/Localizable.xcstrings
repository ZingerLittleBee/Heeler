    "%@ saves this conversation after its first reply.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は最初の応答後にこの会話を保存します。"
          }
        }
      }
    },
    "%@ saves this conversation after its first reply. Send a message to start it.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は最初の応答後にこの会話を保存します。メッセージを送ると開始できます。"
          }
        }
      }
    },
    "%@ saves this conversation once it has a first message.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は最初のメッセージを受け取るとこの会話を保存します。"
          }
        }
      }
    },
    "%@ saves this conversation once it has a first message. Send a message to start it.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は最初のメッセージを受け取るとこの会話を保存します。メッセージを送ると開始できます。"
          }
        }
      }
    },
    "%@ started with its extensions turned off (--no-extensions), so Heeler's extension, which names the conversation, isn't running in this session. Start the Agent again without --no-extensions.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は拡張機能をオフにして（--no-extensions）起動したため、会話を特定する Heeler の拡張機能がこのセッションで動作していません。--no-extensions を使わずにエージェントを再起動してください。"
          }
        }
      }
    },
