    "Custom names start with $ and contain 1–32 letters, digits, underscores or hyphens. Values come from herdr plugins and display as plain text." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カスタム名は $ で始まり、1〜32 文字の英字・数字・アンダースコア・ハイフンを使えます。値は herdr プラグイン由来で、プレーンテキストとして表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自定义名称以 $ 开头，可包含 1–32 个字母、数字、下划线或连字符。值来自 herdr 插件，并以纯文本显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自訂名稱以 $ 開頭，並包含 1–32 個字母、數字、底線或連字號。值來自 herdr 外掛，並以純文字顯示。"
          }
        }
      }
