    "Codex compressed this conversation's rollout, which Chat can't read.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Codex はこの会話のロールアウトを圧縮したため、チャットは読み取れません。"
          }
        }
      }
    },
    "Codex did not produce a title suggestion in time.": {
      "extractionState": "manual",
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
