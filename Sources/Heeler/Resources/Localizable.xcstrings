    "%@ If an admin must approve this device, authorize it in the network's admin console." : {
      "comment" : "Overlay failure explanation. %@ is the overlay's own detail sentence, which may be English.",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
