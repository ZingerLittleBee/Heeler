    },
    "Codex reports its conversation after a prompt. Send one to show it here." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex はプロンプトのあとに会話を報告します。送るとここに表示されます。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex 会在收到提示词后报告其对话。发送一条消息即可在此处显示。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex 會在收到提示後才回報它的對話。傳送一則提示即可顯示在這裡。"
          }
        }
      }
    },
    "Codex runs on its shared background server here, where one terminal's conversation looks like another's. Exit Codex, run codex resume %@, and pick the conversation in Codex's list. %@" : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここで Codex は共有バックグラウンドサーバー上で動作しており、あるターミナルの会話は別の会話と区別が付きません。Codex を終了し、codex resume %1$@ を実行して、Codex のリストで会話を選んでください。%2$@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此处的 Codex 运行在共享后台服务器上，不同终端的对话无法区分。请退出 Codex，运行 codex resume %@，然后在 Codex 列表中选择对话。%@"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex 在這裡執行於它共用的背景伺服器上，一個終端機的對話看起來會與另一個相同。請結束 Codex，執行 codex resume %@，然後在 Codex 的清單中選擇對話。%@"
          }
        }
      }
    },
    "Codex runs on its shared background server, so Chat can't tell this conversation." : {
      "comment" : "Chat banner",
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex は共有バックグラウンドサーバー上で動作しているため、チャットはこの会話を特定できません。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex 运行在共享后台服务器上，因此对话无法确定此对话。"
