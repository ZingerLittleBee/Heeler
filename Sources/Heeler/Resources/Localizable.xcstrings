        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 在消息提交前已结束，因此未提交任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agent 在訊息送出前已結束，因此沒有送出任何內容。"
          }
        }
      }
    },
    "The Agent ended. %@" : {
