    "NSCameraUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Heeler uses the camera to scan the Pairing Code shown on your computer, so you can add that machine without typing anything."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeler は、何も入力せずにそのマシンを追加できるよう、コンピューターに表示されたペアリングコードの読み取りにカメラを使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeler 使用相机扫描电脑上显示的配对码，这样无需输入任何内容即可添加那台电脑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeler 會使用相機掃描電腦上顯示的配對碼，讓你不必輸入任何內容就能新增該機器。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Heeler uses your local network to connect directly to Hosts on your Tailscale, ZeroTier, or EasyTier network when they are nearby, and to find machines that offer SSH."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeler は、近くにある Tailscale、ZeroTier、EasyTier ネットワーク上のホストへ直接接続するため、および SSH を提供するマシンを探すために、お使いのローカルネットワークを使用します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeler 使用本地网络，在 Tailscale、ZeroTier 或 EasyTier 网络中的主机就在附近时直接连接它们，并查找提供 SSH 的电脑。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeler 會使用本地網路，在 Tailscale、ZeroTier 或 EasyTier 網路上的主機位於附近時直接連線，並尋找提供 SSH 的機器。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Heeler records your voice when you tap the microphone in the Composer, and sends the recording to the speech service you chose in Settings to turn it into text."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Heeler は、コンポーザーのマイクをタップしたときにあなたの声を録音し、設定で選択した音声サービスに録音を送ってテキストに変換します。"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当你轻点输入框中的麦克风时，Heeler 会录下你的语音，并将录音发送到你在“设置”中选择的语音服务，转换为文字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當你點選輸入框中的麥克風時，Heeler 會錄下你的聲音，並將錄音傳送到你在「設定」中選擇的語音服務，轉換成文字。"
          }
        }
      }
    }
  },
  "version" : "1.0"
}